# Telegram API credentials — https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# HTTP / WebSocket listen
HOST=127.0.0.1
PORT=3111

# Токен для создания/удаления аккаунтов (POST /v1/accounts).
# Пусто = эндпоинт открыт; допустимо только при HOST=127.0.0.1.
ADMIN_TOKEN=

# Data directory (resolved from project root)
DATA_DIR=./data

# Писать поток обновлений в data/updates.jsonl (в лог попадают тексты сообщений)
LOG_UPDATES=false

# JSONL update-log rotation threshold in MB
UPDATES_MAX_MB=50

# Замер выдачи файлов в журнал: сколько заняло описание вложения, сколько шёл
# первый байт, с какой скоростью ушло тело. Строка на каждый Range-запрос
# плеера — включать стоит только когда разбираешься, почему видео открывается
# долго, и выключать сразу после.
LOG_MEDIA_TIMING=false

# Источники, которым разрешены браузерные запросы (через запятую).
# Пусто — CORS выключен и веб-клиент работать не сможет.
# Пример для локальной веб-версии mobiGram: http://127.0.0.1:8080
CORS_ORIGINS=

# Прокси для MTProto-соединения (общий на все аккаунты).
# Пусто — прямое подключение. Авторизация опциональна, спецсимволы в пароле
# кодируются percent-encoding (@ → %40, : → %3A).
#   socks5://[user:pass@]host:1080
#   socks4://host:1080
#   http://[user:pass@]host:3128      HTTP CONNECT
#   https://[user:pass@]host:8443     то же, но TLS до самого прокси
#   mtproxy://<секрет>@host:443       прокси Telegram (или ?secret=…)
PROXY_URL=

# Таймаут подключения к прокси, секунды
PROXY_TIMEOUT=5

# Брать прокси из системных переменных, если PROXY_URL пуст:
# https_proxy → all_proxy → http_proxy (регистр любой, PROXY_URL всё равно важнее).
# По умолчанию выключено: эти переменные часто выставлены в шелле для других задач,
# и трафик Telegram не должен уходить туда молча.
PROXY_FROM_ENV=false
